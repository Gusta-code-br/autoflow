# Copie para .env e preencha. O .env nunca vai para o git.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---------------------------------------------------------------- banco
# App: usuário com RLS ligado (NÃO use o owner aqui — o RLS não se aplica ao
# dono da tabela e o isolamento entre organizações some sem aviso).
DATABASE_URL=postgres://autoflow_app:senha@localhost:5432/autoflow

# Worker: papel BYPASSRLS e conexão direta, sem pooler em modo transaction —
# FOR UPDATE SKIP LOCKED precisa de sessão real.
DATABASE_URL_DIRETA=postgres://autoflow_worker:senha@localhost:5432/autoflow

# Migração: usuário dono do schema (roda o DDL). Só usado por `npm run db:migrate`.
DATABASE_URL_MIGRACAO=postgres://autoflow_owner:senha@localhost:5432/autoflow

DB_POOL_MAX=10
DB_POOL_WORKER=4

# ---------------------------------------------------------------- segredos
# Assina o cookie de sessão. Trocar invalida todas as sessões. Mínimo 32 chars.
AUTH_SECRET=

# Cifra os tokens de WhatsApp no banco (AES-256-GCM), 32 bytes em base64.
# Para rotacionar: crie CRYPTO_KEY_V2, suba CRYPTO_KEY_VERSAO=2 e mantenha a V1
# no ambiente até rescrever as linhas antigas.
CRYPTO_KEY_V1=
CRYPTO_KEY_VERSAO=1

# ---------------------------------------------------------------- app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- WhatsApp
# Valida a assinatura X-Hub-Signature-256 do webhook da Meta.
META_APP_SECRET=
# Você escolhe este valor; repita igual no painel da Meta ao registrar a URL.
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
META_API_BASE=https://graph.facebook.com

# Embedded Signup (botão "Conectar com um clique" na tela de Conexões): o
# cliente loga com a conta de WhatsApp Business dele numa janela da Meta em
# vez de colar token e Phone Number ID à mão. App Meta > Painel do WhatsApp >
# Configuração > Embedded Signup. META_APP_ID é o mesmo app da linha acima —
# repetido aqui como NEXT_PUBLIC_ porque o SDK que abre o pop-up roda no
# navegador do cliente, não no servidor. Sem as três variáveis o botão some
# sozinho e só sobra o formulário manual (nenhuma conta fica sem forma de
# conectar).
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ---------------------------------------------------------------- Mercado Pago
# Cobra assinatura/créditos da própria organização AutoFlow (não confundir com
# o token do onboarding do cliente, que é outra credencial, guardada por org).
MERCADOPAGO_ACCESS_TOKEN=
# Painel do MP > Suas integrações > Webhooks > Configurar notificação — chave
# usada para validar a assinatura, diferente do access token acima.
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- IA
# Gera as respostas automáticas (worker "responder-ia", consome a fila
# `tarefa` tipo 'responder_ia' criada em src/server/webhooks/entrada.ts).
# Sem isso a tarefa fica represada e o cliente nunca recebe a resposta.
OPENAI_API_KEY=
# Opcional — usa este valor se a variável não estiver definida.
OPENAI_MODEL=gpt-4o-mini