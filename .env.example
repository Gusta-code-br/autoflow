# Copie para .env e preencha. O .env nunca vai para o git.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---------------------------------------------------------------- banco
# App: usuário com RLS ligado (NÃO use o owner aqui — o RLS não se aplica ao
# dono da tabela e o isolamento entre organizações some sem aviso).
DATABASE_URL=postgres://autoflow_app:senha@localhost:5432/autoflow

# Worker: papel BYPASSRLS e conexão direta, sem pooler em modo transaction —
# FOR UPDATE SKIP LOCKED precisa de sessão real.
DATABASE_URL_DIRETA=postgres://autoflow_worker:senha@localhost:5432/autoflow

# Migração: usuário dono do schema (roda o DDL). Só usado por `npm run db:migrate`.
DATABASE_URL_MIGRACAO=postgres://autoflow_owner:senha@localhost:5432/autoflow

DB_POOL_MAX=10
DB_POOL_WORKER=4

# ---------------------------------------------------------------- segredos
# Assina o cookie de sessão. Trocar invalida todas as sessões. Mínimo 32 chars.
AUTH_SECRET=

# Cifra os tokens de WhatsApp no banco (AES-256-GCM), 32 bytes em base64.
# Para rotacionar: crie CRYPTO_KEY_V2, suba CRYPTO_KEY_VERSAO=2 e mantenha a V1
# no ambiente até rescrever as linhas antigas.
CRYPTO_KEY_V1=
CRYPTO_KEY_VERSAO=1

# ---------------------------------------------------------------- app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- WhatsApp
# Valida a assinatura X-Hub-Signature-256 do webhook da Meta.
META_APP_SECRET=
# Você escolhe este valor; repita igual no painel da Meta ao registrar a URL.
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
META_API_BASE=https://graph.facebook.com
