{
  "name": "autoflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/worker.ts",
    "test": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/migrar.ts",
    "db:semear": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/semear.ts",
    "smoke:cadastro": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/smoke-cadastro-real.mts"
  },
  "dependencies": {
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
